{
  "name": "Millie CFO",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "npm ci --no-audit --no-fund",
  "postStartCommand": "bash .devcontainer/start-preview.sh",
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "Millie CFO preview", "onAutoForward": "notify" } },
  "customizations": { "codespaces": { "openFiles": ["README.md"] } }
}
